{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/blue126/agent-project-bootstrap/schemas/validation-adapter.schema.json",
  "title": "Repository validation adapter manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "id", "version", "license", "entrypoint", "supported_stacks"],
  "properties": {
    "contract_version": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "version": {"type": "string", "minLength": 1},
    "license": {"type": "string", "minLength": 1},
    "entrypoint": {"type": "string", "minLength": 1},
    "supported_stacks": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "upstream": {"type": "string", "format": "uri"}
  }
}
