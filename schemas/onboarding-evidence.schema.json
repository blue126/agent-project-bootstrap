{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/blue126/agent-project-bootstrap/schemas/onboarding-evidence.schema.json",
  "title": "Onboarding evidence configuration and verification receipts",
  "description": "Configuration is not proof. Remote receipts must be rechecked live. Local receipts are issued only by explicit --run-local --command-file; the private Git-directory key detects receipt edits, not a malicious local user. Coverage is tracked and non-ignored files only. Commands are never executed by ordinary evidence verification.",
  "oneOf": [
    {"$ref": "#/$defs/evidence"},
    {"$ref": "#/$defs/result"},
    {"$ref": "#/$defs/command"}
  ],
  "$defs": {
    "sha": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "argv": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "command": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "argv"],
      "properties": {"schema_version": {"const": 1}, "argv": {"$ref": "#/$defs/argv"}}
    },
    "check": {
      "type": "object", "additionalProperties": false,
      "required": ["context", "integration_id"],
      "properties": {
        "context": {"type": "string", "minLength": 1},
        "integration_id": {"type": "integer", "minimum": 1},
        "workflow_id": {"type": "integer", "minimum": 1},
        "head_sha": {"$ref": "#/$defs/sha"},
        "check_run_id": {"type": "integer", "minimum": 1},
        "workflow_run_id": {"type": "integer", "minimum": 1}
      }
    },
    "ci_check": {
      "allOf": [
        {"$ref": "#/$defs/check"},
        {"required": ["workflow_id"], "properties": {"integration_id": {"const": 15368}}}
      ]
    },
    "local": {
      "type": "object", "additionalProperties": false,
      "required": ["project", "head_sha", "target_digest", "command_file", "command_digest", "argv", "exit_code", "signature"],
      "properties": {
        "project": {"type": "string", "minLength": 1},
        "head_sha": {"anyOf": [{"$ref": "#/$defs/sha"}, {"type": "null"}]},
        "target_digest": {"$ref": "#/$defs/digest"},
        "command_file": {"type": "string", "minLength": 1},
        "command_digest": {"$ref": "#/$defs/digest"},
        "argv": {"$ref": "#/$defs/argv"},
        "exit_code": {"const": 0},
        "signature": {"$ref": "#/$defs/digest"}
      }
    },
    "review": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false, "required": ["type", "reviewer"],
          "properties": {
            "type": {"enum": ["github_review", "feedback"]},
            "reviewer": {"type": "string", "minLength": 1},
            "review_id": {"type": "integer", "minimum": 1},
            "state": {"enum": ["APPROVED", "COMMENTED", "CHANGES_REQUESTED"]},
            "commit_id": {"$ref": "#/$defs/sha"}
          }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["type", "check"],
          "properties": {"type": {"const": "check"}, "check": {"$ref": "#/$defs/check"}}
        }
      ]
    },
    "evidence": {
      "type": "object", "additionalProperties": false, "required": ["schema_version"],
      "properties": {
        "schema_version": {"const": 1},
        "local": {"$ref": "#/$defs/local"},
        "repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
        "pr": {"type": ["integer", "null"], "minimum": 1},
        "head_sha": {"$ref": "#/$defs/sha"},
        "checks": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/ci_check"}},
        "review": {"$ref": "#/$defs/review"},
        "base_branch": {"type": "string", "minLength": 1},
        "coverage": {"enum": ["configured_checks", "review_integration_only"]},
        "baseline_verified": {"type": "boolean"},
        "checks_verified": {"type": "boolean"},
        "ruleset_ids": {"type": "array", "items": {"type": "integer", "minimum": 1}}
      },
      "anyOf": [
        {"required": ["local"]},
        {"required": ["repository", "pr", "head_sha", "checks"]},
        {"required": ["repository", "pr", "head_sha", "review"]}
      ]
    },
    "result": {
      "type": "object", "additionalProperties": false, "required": ["status", "reason", "evidence"],
      "properties": {
        "status": {"enum": ["verified", "blocked"]},
        "reason": {"type": "string", "minLength": 1},
        "evidence": {"type": "object"}
      },
      "if": {"properties": {"status": {"const": "verified"}}},
      "then": {"properties": {"evidence": {"$ref": "#/$defs/evidence"}}}
    }
  }
}
