{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/blue126/agent-project-bootstrap/schemas/thread-resolution.schema.json",
  "title": "Review thread ownership and active finding state",
  "type": "object",
  "additionalProperties": false,
  "required": ["active_fingerprints", "threads"],
  "properties": {
    "active_fingerprints": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "threads": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "owner", "fingerprint", "resolved"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "owner": {"enum": ["bot", "human"]},
          "fingerprint": {"type": "string", "minLength": 1},
          "resolved": {"type": "boolean"}
        }
      }
    }
  }
}
