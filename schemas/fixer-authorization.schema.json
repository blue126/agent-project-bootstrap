{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/blue126/agent-project-bootstrap/schemas/fixer-authorization.schema.json",
  "title": "Trusted Fixer pre-push authorization input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "repository", "pull_request", "state", "draft", "fork", "head_repository",
    "actor", "allowed_actors", "head_ref", "default_branch", "api_head_sha",
    "expected_head_sha", "proposed_commit_sha", "proposed_parent_sha", "changed_paths"
  ],
  "properties": {
    "repository": {"type": "string"},
    "pull_request": {"type": "integer", "minimum": 1},
    "state": {"const": "open"},
    "draft": {"type": "boolean"},
    "fork": {"type": "boolean"},
    "head_repository": {"type": "string"},
    "actor": {"type": "string", "minLength": 1},
    "allowed_actors": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "head_ref": {"type": "string", "minLength": 1},
    "default_branch": {"type": "string", "minLength": 1},
    "api_head_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "expected_head_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "proposed_commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "proposed_parent_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "changed_paths": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
  }
}
