{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/blue126/agent-project-bootstrap/schemas/validation-result.schema.json",
  "title": "Repository validation result",
  "type": "object",
  "additionalProperties": false,
  "required": ["repository", "pull_request", "validated_sha", "adapter", "status", "summary"],
  "properties": {
    "repository": {"type": "string", "pattern": "^[^/\\s]+/[^/\\s]+$"},
    "pull_request": {"type": "integer", "minimum": 1},
    "validated_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "manifest_sha256"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "version": {"type": "string", "minLength": 1},
        "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "status": {"enum": ["pass", "fail"]},
    "summary": {"type": "string", "minLength": 1, "maxLength": 2000}
  }
}
